---
import "../styles.css";
interface Props {
  readonly title: string;
  readonly pageType?: "map" | "story" | "browse" | "reader";
  readonly noindex?: boolean;
}
const { title, pageType = "map", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://oldphilly.org");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f5ed" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta
      name="description"
      content="Philadelphia menus from NYPL and the Culinary Institute of America, with scans, transcribed dishes and prices."
    />
  </head>
  <body class={`${pageType}-page`} data-asset-base={import.meta.env.BASE_URL}>
    <a
      class="skip"
      href={pageType === "map" ? "#menu-panel" : pageType === "story" ? "#story" : "#content"}
    >
      {pageType === "map" ? "Skip to menu" : "Skip to content"}
    </a>
    <slot />
    {pageType === "map" && (
      <noscript>
        The map requires JavaScript. <a href={`${import.meta.env.BASE_URL}menus.json`}>Menu data</a>
      </noscript>
    )}
  </body>
</html>
