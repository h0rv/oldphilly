---
import Page from "../layouts/Page.astro";
import { parseCatalog } from "../catalog-model.ts";
import { venueGroups, dateSummary } from "../venue-groups.ts";
import raw from "../../public/catalog.json";
const catalog = parseCatalog(raw);
const base = import.meta.env.BASE_URL;
const groups = venueGroups(catalog);
const restaurants = groups.filter(
  (group) => group.venue.kind === "restaurant" || group.venue.kind === "hotel",
);
const other = groups.filter(
  (group) => group.venue.kind !== "restaurant" && group.venue.kind !== "hotel",
);
---

<Page title="Old Philly Menus · Restaurants and menus" pageType="browse">
  <header class="browse-header">
    <h1>
      <a href={base}>Old Philly Menus</a>
    </h1>
    <nav aria-label="Menus">
      <a href={`${base}map/`}>Map</a>
      <a href={`${base}story/`}>Three menus</a>
    </nav>
  </header>
  <main id="content" class="browse-content">
    <h2>Restaurants and hotels</h2>
    <label class="restaurant-search">
      Find a restaurant
      <input
        id="restaurant-search"
        type="search"
        placeholder="Name or address"
        autocomplete="off"
      />
    </label>
    <p id="browse-count" role="status"></p>
    <div class="restaurant-list">
      {restaurants.map(({ venue, menus, venueIds }) => (
        <article
          class="restaurant-card"
          id={`restaurant-${venue.id}`}
          data-restaurant
          data-search={`${venue.name} ${venue.branch ?? ""} ${menus.map((menu) => `${menu.name} ${menu.location.address ?? ""} ${menu.date.label}`).join(" ")}`.toLowerCase()}
        >
          <h3>
            <a data-context-link href={`${base}restaurants/${venue.id}/`}>
              {venue.name}
            </a>
          </h3>
          {venueIds.length === 1 && venue.branch !== null && <p>{venue.branch}</p>}
          <p>
            {menus.length} {menus.length === 1 ? "menu" : "menus"} · {dateSummary(menus)}
          </p>
        </article>
      ))}
    </div>
    <details class="other-menus" open>
      <summary>Other menus</summary>
      <div class="restaurant-list">
        {other.map(({ venue, menus }) => (
          <article
            class="restaurant-card"
            id={`restaurant-${venue.id}`}
            data-restaurant
            data-search={`${venue.name} ${menus.map((menu) => menu.name).join(" ")}`.toLowerCase()}
          >
            <h3>
              <a data-context-link href={`${base}restaurants/${venue.id}/`}>
                {venue.name}
              </a>
            </h3>
            <p>
              {menus.length} {menus.length === 1 ? "menu" : "menus"} · {dateSummary(menus)}
            </p>
          </article>
        ))}
      </div>
    </details>
    <p id="browse-empty" hidden>
      No restaurants or menus match.
    </p>
    <footer>
      <a href={`${base}catalog.json`}>Catalog and review status</a> · <a href="/">Photo map</a>
    </footer>
  </main>
</Page>
<script src="../browse.ts"></script>
<script src="../story-view.ts"></script>
