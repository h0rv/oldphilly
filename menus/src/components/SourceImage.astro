---
import type { StoryEntry } from "../story.ts";
interface Props {
  readonly image: NonNullable<StoryEntry["image"]>;
}
const { image } = Astro.props;
---

<figure class="hero-scan" data-source-image>
  <a href={image.recordUrl} class="scan-image-link">
    <img
      src={image.url}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading="eager"
      decoding="async"
    />
  </a>
  <p class="image-unavailable" hidden>
    Menu image unavailable.
    <br />
    <a href={image.recordUrl}>View the original at NYPL</a>
  </p>
  <figcaption>
    From The New York Public Library · <a href={image.rightsEvidence}>Image &amp; rights</a>
  </figcaption>
</figure>
