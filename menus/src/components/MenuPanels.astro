<main>
  <section class="map-panel" aria-label="Menu locations">
    <div id="map" tabindex="0" aria-label="Philadelphia menu map"></div>
    <p id="map-status" role="status"></p>
  </section>
  <section id="menu-panel" tabindex="-1" aria-label="Selected menu">
    <label class="sr-only" for="menu-picker">
      Choose a menu
    </label>
    <select id="menu-picker" aria-describedby="result-status">
      <option>Loading menus…</option>
    </select>
    <p id="result-status" class="sr-only" role="status" aria-live="polite"></p>
    <article id="menu-content"></article>
  </section>
</main>
