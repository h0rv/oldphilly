{
  "name": "old-philly-menus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "node scripts/build-scans.ts && node scripts/build-catalog.ts && node scripts/validate-data.ts && astro build",
    "import": "node scripts/import.ts",
    "typecheck": "astro sync && node node_modules/typescript-native/bin/tsc --noEmit && astro check --tsconfig tsconfig.astro.json --minimumFailingSeverity warning",
    "lint": "oxlint --type-aware --type-check --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --test test/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "build:site": "node scripts/build-site.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "simpledotcss": "2.3.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "0.5.2",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "astro": "7.4.0",
    "csv-parse": "7.0.3",
    "leaflet-control-geocoder": "2.4.0",
    "maplibre-gl": "5.24.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "npm@11.9.0"
}
